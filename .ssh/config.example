# Project-local SSH configuration. Run ssh from the repository root:
#   ssh -F .ssh/config taei-remote
# Copy this template to .ssh/config and replace HostName, User, Port,
# and IdentityFile as needed. Never commit private keys.
Host taei-remote
    HostName server.example.invalid
    User your-user
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ForwardAgent no
    StrictHostKeyChecking ask
    UserKnownHostsFile .ssh/known_hosts
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ConnectTimeout 10
